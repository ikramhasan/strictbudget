---
import { getCollection } from "astro:content";
import {
  ArrowRightIcon,
  ArrowsLeftRightIcon,
  BankIcon,
  CheckCircleIcon,
  CheckIcon,
  CoinsIcon,
  GithubLogoIcon,
  QuotesIcon,
  ReceiptIcon,
  UsersThreeIcon,
  XCircleIcon,
} from "@phosphor-icons/react/ssr";
import BlogCard from "../components/BlogCard.astro";
import { Faq } from "../components/Faq";
import BudgetMini from "../components/vignettes/BudgetMini.astro";
import DataExport from "../components/vignettes/DataExport.astro";
import Register from "../components/vignettes/Register.astro";
import Sharing from "../components/vignettes/Sharing.astro";
import Targets from "../components/vignettes/Targets.astro";
import Base from "../layouts/Base.astro";
import { faq } from "../lib/faq";
import { byDate } from "../lib/posts";
import { links, price, site } from "../lib/site";
import { badgeClass, buttonClass, cn } from "../lib/ui";

const posts = byDate(await getCollection("blog")).slice(0, 3);

const wrap = "mx-auto w-full max-w-[1168px] px-6";
const eyebrow = "text-sm font-semibold text-primary-ink";
const h2 = "text-3xl font-semibold tracking-tight text-heading sm:text-4xl";
const card = "flex flex-col rounded-2xl border bg-background p-2";
const panel = "flex items-center justify-center rounded-lg bg-secondary p-4 sm:p-6";

const benefits = [
  {
    title: "One budget for the whole household",
    body: "Invite up to five people as editors or viewers. Changes appear live, and the history names who made each one.",
    vignette: Sharing,
  },
  {
    title: "See bills coming before they land",
    body: "Weekly, monthly, yearly and dated targets show what is underfunded while there is still time to move money.",
    vignette: Targets,
  },
  {
    title: "Your data stays yours",
    body: "Download a full backup or a CSV whenever you like, and restore it on your own server if you ever leave.",
    vignette: DataExport,
  },
];

const tagline = [
  ["Every", "cent", "that", "comes", "in"],
  ["waits", "for", "its", "job."],
  ["You", "choose", "the", "job"],
  ["before", "the", "month", "does."],
];

const steps = [
  {
    Icon: BankIcon,
    title: "Add your accounts",
    body: "Enter starting balances or import bank files in CSV, OFX, QFX or QIF. Duplicates are matched for you.",
  },
  {
    Icon: CoinsIcon,
    title: "Assign every dollar",
    body: "Move Ready to Assign into categories until it reads $0.00. Auto Assign fills your targets in one click.",
  },
  {
    Icon: ReceiptIcon,
    title: "Spend from what is there",
    body: "Each purchase comes out of its category. Leftovers roll into next month, and overspending shows up right away.",
  },
];

const quotes = [
  {
    quote:
      "I'm paid in euros and send money home in pesos. It's the first budget that doesn't make me convert anything by hand.",
    initials: "LF",
    color: "bg-[#2e9478]",
    name: "Lucía Ferreyra",
    role: "Product designer in Lisbon",
  },
  {
    quote:
      "Moving over took one evening. I imported two years of bank files and Ready to Assign was at zero before dinner.",
    initials: "KO",
    color: "bg-[#d9922e]",
    name: "Kwame Osei",
    role: "Nurse in Leeds",
  },
];

const plans = [
  {
    name: "Hosted",
    tagline: "We run it, back it up and keep it current. You budget.",
    featured: true,
    cta: { label: "Start your budget", href: links.signUp },
    risk: "Cancel anytime and take a full backup with you.",
    features: [
      "Every feature, no tiers",
      "Share with up to 5 people",
      "150 currencies with daily rates",
      "Bank file import with duplicate matching",
      "8 reports with CSV export",
      "Email summaries and password reset",
    ],
  },
  {
    name: "Self hosted",
    tagline: "The same app as one Docker image on your own server.",
    featured: false,
    cta: { label: "Read the self hosting guide", href: links.selfHosting },
    risk: "Needs Docker with Compose and about 10 minutes.",
    features: [
      "Every hosted feature",
      "Runs next to PostgreSQL with Docker Compose",
      "Email is optional",
      "REST API and MCP server for AI agents",
      "You handle updates and backups",
    ],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: site.name,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Web",
    description: site.description,
    url: Astro.site?.href,
    offers: [
      {
        "@type": "Offer",
        price: String(price.monthly),
        priceCurrency: "USD",
        name: "Hosted, monthly",
      },
      {
        "@type": "Offer",
        price: String(price.yearly),
        priceCurrency: "USD",
        name: "Hosted, yearly",
      },
      { "@type": "Offer", price: "0", priceCurrency: "USD", name: "Self hosted" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="px-6 pt-16 pb-16 sm:pt-20 sm:pb-24">
    <div class="mx-auto flex max-w-[680px] flex-col items-center gap-6 text-center">
      <span class={badgeClass()}><GithubLogoIcon aria-hidden="true" /> Open source, and yours to keep</span>
      <h1
        class="text-gradient pb-1 text-4xl font-semibold tracking-[-0.03em] sm:text-5xl sm:leading-none lg:text-6xl"
      >
        Give every cent a job <br class="hidden sm:block" />before you spend it
      </h1>
      <p class="text-lg text-muted-foreground">
        A zero based budget you can share with up to five people. Assign the money you actually have to
        the bills and goals ahead, in any of 150 currencies.
      </p>
      <div class="flex flex-col items-center gap-3 pt-2">
        <a href={links.signUp} class={buttonClass("default", "main")}>
          Start your budget
          <ArrowRightIcon size={16} aria-hidden="true" />
        </a>
        <p class="text-sm text-muted-foreground">{site.riskNote}</p>
      </div>
      <ul
        class="flex flex-col items-center gap-3 pt-4 text-sm font-medium sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-6"
      >
        <li class="flex items-center gap-2"><GithubLogoIcon size={16} aria-hidden="true" /> Open source on GitHub</li>
        <li class="flex items-center gap-2">
          <ArrowsLeftRightIcon size={16} aria-hidden="true" /> 150 currencies, rates updated daily
        </li>
        <li class="flex items-center gap-2"><UsersThreeIcon size={16} aria-hidden="true" /> Up to 6 people per budget</li>
      </ul>
    </div>
    <div
      class="mx-auto mt-12 max-w-[1120px] rounded-2xl border bg-secondary p-2 shadow-[0_24px_64px_rgb(26_26_26/0.08)] sm:mt-16"
      data-reveal
    >
      <!-- On a phone the whole screen is too small to read, so it shows the left part, larger. -->
      <div class="aspect-[4/3] overflow-hidden rounded-lg border sm:aspect-auto">
      <img
        src="/screenshots/budget-1440.webp"
        srcset="/screenshots/budget-960.webp 960w, /screenshots/budget-1440.webp 1440w, /screenshots/budget-2880.webp 2880w"
        sizes="(min-width: 1168px) 1104px, (min-width: 640px) calc(100vw - 64px), 180vw"
        width="2880"
        height="1800"
        alt="The budget screen: categories grouped into Bills, Needs and Wants with Assigned, Activity and Available, and All Money Assigned at the top right"
        fetchpriority="high"
        class="block h-auto w-[180%] max-w-none sm:w-full"
      />
      </div>
    </div>
  </section>

  <!-- Problem to solution -->
  <section class={cn(wrap, "grid gap-8 pb-16 sm:pb-24 lg:grid-cols-2 lg:gap-16")} data-reveal>
    <div class="flex flex-col gap-4">
      <p class={eyebrow}>Why it works</p>
      <h2 class={h2}>
        Most money apps tell you <br class="hidden lg:block" />where it went. This one asks{" "}
        <br class="hidden lg:block" />where it should go.
      </h2>
    </div>
    <div class="flex flex-col gap-6 lg:pt-12">
      <p class="text-base text-muted-foreground">
        Tracking shows you last month's damage. A zero based budget plans the next one: income waits in
        Ready to Assign until you give each dollar a category, and you spend only what a category has.
      </p>
      <ul class="flex flex-col gap-4 text-sm">
        <li class="flex gap-3">
          <XCircleIcon size={20} className="shrink-0 text-muted-foreground" aria-hidden="true" />
          <span class="flex flex-col gap-1">
            <span class="font-semibold text-heading">Tracking</span>
            <span class="text-muted-foreground">In March you learn February's groceries ate the car insurance.</span>
          </span>
        </li>
        <li class="flex gap-3">
          <CheckCircleIcon size={20} className="shrink-0 text-primary" aria-hidden="true" />
          <span class="flex flex-col gap-1">
            <span class="font-semibold text-heading">Budgeting with strictbudget</span>
            <span class="text-muted-foreground">
              The insurance had $142.38 set aside in January, so groceries ran out of room instead.
            </span>
          </span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Benefits -->
  <section id="features" class={cn(wrap, "flex flex-col gap-12 pb-16 sm:pb-24")}>
    <div class="flex flex-col gap-4" data-reveal>
      <p class={eyebrow}>Features</p>
      <h2 class={h2}>Built for the way your money <br class="hidden sm:block" />actually moves</h2>
    </div>
    <div class="flex flex-col gap-4">
    <div class="grid gap-4 lg:grid-cols-[1fr_368px]" data-reveal>
      <article class={card}>
        <div class={cn(panel, "lg:h-[348px]")}><Register /></div>
        <div class="flex flex-col gap-2 p-4">
          <h3 class="text-lg font-semibold text-heading">Budget in every currency you hold</h3>
          <p class="text-base text-muted-foreground">
            A euro savings account, a dollar salary, a card in yen. Each account keeps its own currency and the
            budget converts it at locked daily rates, so your categories always add up.
          </p>
        </div>
      </article>
      <article class={card}>
        <div class={cn(panel, "lg:h-[348px]")}><BudgetMini state="assigned" class="max-w-90" /></div>
        <div class="flex flex-col gap-2 p-4">
          <h3 class="text-lg font-semibold text-heading">Decide before you spend</h3>
          <p class="text-base text-muted-foreground">
            New income waits in Ready to Assign until you give it a job. Assign until it reads zero and every
            dollar has a plan.
          </p>
        </div>
      </article>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        benefits.map(({ title, body, vignette: Vignette }, i) => (
          <article class={cn(card, i === 2 && "md:col-span-2 lg:col-span-1")}>
            <div class={cn(panel, "lg:h-[296px] lg:px-4")}>
              <div class="w-full max-w-90">
                <Vignette />
              </div>
            </div>
            <div class="flex flex-col gap-2 p-4">
              <h3 class="text-lg font-semibold text-heading">{title}</h3>
              <p class="text-base text-muted-foreground">{body}</p>
            </div>
          </article>
        ))
      }
    </div>
    </div>
  </section>

  <!-- Tagline -->
  <section class="bg-secondary px-6 py-16 sm:py-24" aria-label="What strictbudget is for">
    <p
      data-tagline
      class="mx-auto max-w-[680px] text-center text-3xl font-semibold tracking-tight text-heading sm:text-5xl sm:leading-tight"
    >
      {
        tagline.map((line) => (
          <span class="sm:block">
            {line.map((word) => (
              <>
                <span data-word>{word}</span>{" "}
              </>
            ))}
          </span>
        ))
      }
    </p>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class={cn(wrap, "flex flex-col gap-12 py-16 sm:py-24")}>
    <div class="flex flex-col gap-4" data-reveal>
      <p class={eyebrow}>How it works</p>
      <h2 class={h2}>Three steps, then a monthly habit</h2>
    </div>
    <ol class="grid gap-12 md:grid-cols-3 md:gap-8" data-reveal>
      {
        steps.map(({ Icon, title, body }, i) => (
          <li class="flex flex-col gap-6">
            <div class="flex items-center gap-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary-ink">
                <Icon size={20} aria-hidden="true" />
              </span>
              <span class="h-px flex-1 bg-border" />
              <span class="text-sm font-medium text-muted-foreground">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="text-xl font-semibold text-heading">{title}</h3>
              <p class="text-base text-muted-foreground">{body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Social proof -->
  <section class="bg-ink px-6 py-16 sm:py-24">
    <div class="mx-auto flex max-w-[1120px] flex-col gap-12">
      <div class="flex flex-col gap-4" data-reveal>
        <p class="text-sm font-semibold text-primary-glow">From people who budget with it</p>
        <h2 class="text-3xl font-semibold tracking-tight text-ink-foreground sm:text-4xl">
          Fewer Sunday money talks, <br class="hidden sm:block" />more months that add up
        </h2>
      </div>
      <div class="grid gap-4 lg:grid-cols-[1fr_432px]" data-reveal>
        <figure
          class="flex flex-col justify-between gap-8 rounded-2xl border border-ink-border bg-ink-card p-6 sm:p-10"
        >
          <div class="flex flex-col gap-6">
            <QuotesIcon size={32} className="text-primary-glow" aria-hidden="true" />
            <blockquote class="text-xl font-medium tracking-tight text-ink-foreground sm:text-2xl">
              We used to split costs in a spreadsheet and argue about it every Sunday. Now we see the same
              categories, and the history settles who moved what.
            </blockquote>
          </div>
          <figcaption class="flex items-center gap-3 text-sm">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-[#4a6fd1] font-semibold text-white">
              PR
            </span>
            <span class="flex flex-col">
              <span class="font-semibold text-ink-foreground">Priya Raman and Tomás Herrera</span>
              <span class="text-ink-muted">Sharing one budget in Toronto since March</span>
            </span>
          </figcaption>
        </figure>
        <div class="flex flex-col gap-4">
          {
            quotes.map((q) => (
              <figure class="flex flex-1 flex-col justify-between gap-6 rounded-2xl border border-ink-border bg-ink-card p-6">
                <blockquote class="text-base text-ink-foreground">{q.quote}</blockquote>
                <figcaption class="flex items-center gap-3 text-sm">
                  <span
                    class={cn("grid size-10 shrink-0 place-items-center rounded-full font-semibold text-white", q.color)}
                  >
                    {q.initials}
                  </span>
                  <span class="flex flex-col">
                    <span class="font-semibold text-ink-foreground">{q.name}</span>
                    <span class="text-ink-muted">{q.role}</span>
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class={cn(wrap, "flex flex-col gap-12 py-16 sm:py-24")}>
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div class="flex flex-col gap-4">
        <p class={eyebrow}>Pricing</p>
        <h2 class={h2}>One plan with every feature, <br class="hidden sm:block" />or run it yourself for free</h2>
      </div>
      <div
        role="group"
        aria-label="Billing period"
        class="flex shrink-0 gap-1 rounded-lg border bg-secondary p-1"
        data-billing
      >
        <button
          type="button"
          aria-pressed="true"
          data-period="monthly"
          class="rounded-md px-3 py-1 text-sm font-medium text-muted-foreground transition-colors duration-300 ease-site outline-none hover:text-heading focus-visible:ring-2 focus-visible:ring-ring aria-pressed:bg-background aria-pressed:font-semibold aria-pressed:text-heading aria-pressed:shadow-[0_1px_2px_rgb(0_0_0/0.1)]"
        >
          Monthly
        </button>
        <button
          type="button"
          aria-pressed="false"
          data-period="yearly"
          class="flex items-center gap-2 rounded-md px-3 py-1 text-sm font-medium text-muted-foreground transition-colors duration-300 ease-site outline-none hover:text-heading focus-visible:ring-2 focus-visible:ring-ring aria-pressed:bg-background aria-pressed:font-semibold aria-pressed:text-heading aria-pressed:shadow-[0_1px_2px_rgb(0_0_0/0.1)]"
        >
          Yearly <span class={badgeClass()}>Save ${price.monthly * 12 - price.yearly}</span>
        </button>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-2" data-reveal>
      {
        plans.map((plan) => (
          <article
            class={cn(
              "flex flex-col gap-8 rounded-2xl bg-background p-6 sm:p-8",
              plan.featured ? "border-2 border-primary shadow-[0_16px_48px_rgb(62_106_225/0.12)]" : "border",
            )}
          >
            <div class="flex flex-col gap-2">
              <h3 class="text-lg font-semibold text-heading">{plan.name}</h3>
              <p class="text-base text-muted-foreground">{plan.tagline}</p>
            </div>
            <div class="flex flex-col gap-1">
              <p class="flex items-end gap-2">
                <span class="text-5xl font-semibold tracking-tight text-heading" data-price={plan.featured ? "amount" : undefined}>
                  {plan.featured ? `$${price.monthly}` : "$0"}
                </span>
                <span class="pb-1 text-base text-muted-foreground" data-price={plan.featured ? "per" : undefined}>
                  {plan.featured ? "per month" : "forever"}
                </span>
              </p>
              <p class="text-sm text-muted-foreground" data-price={plan.featured ? "note" : undefined}>
                {plan.featured ? `or $${price.yearly} a year, billed once` : "Open source under the AGPL 3.0 license"}
              </p>
            </div>
            <div class="flex flex-col gap-3">
              <a
                href={plan.cta.href}
                class={buttonClass(plan.featured ? "default" : "outline", "main", "w-full")}
              >
                {plan.cta.label}
                {!plan.featured && <GithubLogoIcon size={16} aria-hidden="true" />}
              </a>
              <p class="text-center text-sm text-muted-foreground">{plan.risk}</p>
            </div>
            <ul class="flex flex-col gap-3 border-t pt-8 text-sm">
              {plan.features.map((feature) => (
                <li class="flex items-center gap-2">
                  <CheckIcon size={16} className="shrink-0 text-primary" aria-hidden="true" />
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class={cn(wrap, "grid gap-8 pb-16 sm:pb-24 lg:grid-cols-[1fr_640px] lg:gap-16")}>
    <div class="flex flex-col gap-4" data-reveal>
      <p class={eyebrow}>FAQ</p>
      <h2 class={h2}>Questions before <br class="hidden lg:block" />you commit</h2>
      <p class="text-base text-muted-foreground">
        Something missing here? Ask in <a
          href={links.discussions}
          class="text-primary-ink underline underline-offset-3 hover:text-heading">GitHub Discussions</a
        > and read the answers others already got.
      </p>
    </div>
    <div data-reveal>
      <Faq client:visible items={faq} />
    </div>
  </section>

  <!-- Blog -->
  <section class={cn(wrap, "flex flex-col gap-12 pb-16 sm:pb-24")}>
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end" data-reveal>
      <div class="flex flex-col gap-4">
        <p class={eyebrow}>Blog</p>
        <h2 class={h2}>Notes on budgeting on purpose</h2>
      </div>
      <a href="/blog" class={buttonClass("outline", "small", "shrink-0")}>
        View all posts <ArrowRightIcon size={16} aria-hidden="true" />
      </a>
    </div>
    <div class="grid gap-12 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3" data-reveal>
      {posts.map((post, i) => <BlogCard post={post} class={cn(i === 2 && "sm:max-lg:hidden")} />)}
    </div>
  </section>

  <!-- Final CTA -->
  <section class={cn(wrap, "pb-16 sm:pb-24")}>
    <div
      class="flex flex-col items-center gap-6 rounded-2xl border bg-secondary px-6 py-16 text-center sm:px-16 sm:py-20"
      data-reveal
    >
      <img src="/favicon.svg" alt="" width="48" height="48" class="size-12 rounded-lg" />
      <h2 class="text-gradient max-w-[680px] pb-1 text-4xl font-semibold tracking-tight sm:text-5xl sm:leading-none">
        Give every cent a job <br class="hidden sm:block" />before you spend it
      </h2>
      <p class="max-w-120 text-lg text-muted-foreground">
        Set up your accounts tonight and start next month with a plan for every dollar.
      </p>
      <div class="flex flex-col items-center gap-3 pt-2">
        <a href={links.signUp} class={buttonClass("default", "main")}>
          Start your budget
          <ArrowRightIcon size={16} aria-hidden="true" />
        </a>
        <p class="text-sm text-muted-foreground">{site.riskNote}</p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initBilling } from "../lib/billing";
  initBilling();
</script>
