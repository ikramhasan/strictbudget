---
import { getCollection } from "astro:content";
import {
  ArrowRightIcon,
  ArrowsLeftRightIcon,
  BankIcon,
  BookOpenTextIcon,
  ChartBarIcon,
  CheckCircleIcon,
  CheckIcon,
  ClockCountdownIcon,
  CoinsIcon,
  CurrencyCircleDollarIcon,
  DeviceMobileIcon,
  EyeIcon,
  FileCsvIcon,
  GithubLogoIcon,
  GlobeIcon,
  HardDrivesIcon,
  LightbulbIcon,
  MinusIcon,
  PathIcon,
  QuestionIcon,
  QuotesIcon,
  ReceiptIcon,
  RobotIcon,
  SealCheckIcon,
  SquaresFourIcon,
  TagIcon,
  UsersThreeIcon,
  WarningCircleIcon,
} from "@phosphor-icons/react/ssr";
import BlogCard from "../components/BlogCard.astro";
import { Faq } from "../components/Faq";
import AvailablePill from "../components/vignettes/AvailablePill.astro";
import BudgetMini from "../components/vignettes/BudgetMini.astro";
import DataExport from "../components/vignettes/DataExport.astro";
import ProgressBar from "../components/vignettes/ProgressBar.astro";
import Register from "../components/vignettes/Register.astro";
import Sharing from "../components/vignettes/Sharing.astro";
import Base from "../layouts/Base.astro";
import { faq } from "../lib/faq";
import { byDate } from "../lib/posts";
import { links, price, site } from "../lib/site";
import { buttonClass, cn } from "../lib/ui";

// The page's look follows daybridge.com: a soft colour wash over a ruled grid, centred headings in
// medium weight, small outlined pills over each section, tinted cards and product shots on a
// painted backdrop.

const posts = byDate(await getCollection("blog")).slice(0, 3);

const wrap = "mx-auto w-full max-w-[1168px] px-6";
const h2 =
  "text-3xl font-medium tracking-[-0.025em] text-heading sm:text-[2.5rem] sm:leading-[1.15]";
const lead = "text-lg text-muted-foreground";
const cta = buttonClass("default", "main", "btn-glow h-11 px-4");

/**
 * Budget categories floating in the hero's grid, where a calendar would have its events. `wide`
 * tiles sit in the inner columns and only show on wide screens.
 */
const tiles = [
  {
    cell: "col-start-1 row-start-2",
    tint: "bg-tint-violet border-tint-violet-edge",
    name: "💸 Paycheck",
    detail: "+$3,240.00 to assign",
  },
  {
    cell: "col-start-1 row-start-4 row-span-2",
    tint: "bg-tint-green border-tint-green-edge",
    name: "🏠 Rent",
    detail: "$1,450.00 · Funded",
    tall: true,
  },
  {
    cell: "col-start-2 row-start-5",
    wide: true,
    tint: "bg-tint-cobalt border-tint-cobalt-edge",
    name: "⚡ Utilities",
    detail: "$102.00 · Due Nov 18",
  },
  {
    cell: "col-start-7 row-start-2 row-span-2",
    tint: "bg-tint-cobalt border-tint-cobalt-edge",
    name: "🛒 Groceries",
    detail: "$612.40 left this month",
    tall: true,
  },
  {
    cell: "col-start-7 row-start-5",
    tint: "bg-tint-yellow border-tint-yellow-edge",
    name: "✈️ Flights to Lisbon",
    detail: "$820.00 more by May 1",
  },
  {
    cell: "col-start-6 row-start-5",
    wide: true,
    tint: "bg-tint-rose border-tint-rose-edge",
    name: "🍽️ Dining out",
    detail: "−$12.40 overspent",
  },
];

const runsOn = [
  { Icon: GlobeIcon, label: "Web" },
  { Icon: DeviceMobileIcon, label: "Phone" },
  { Icon: HardDrivesIcon, label: "Your server" },
];
const worksWith = [
  { Icon: FileCsvIcon, label: "Bank files" },
  { Icon: ArrowsLeftRightIcon, label: "150 currencies" },
  { Icon: RobotIcon, label: "AI agents" },
];

const features = [
  {
    Icon: CoinsIcon,
    title: "Decide before you spend",
    body: "New income waits in Ready to Assign until you give it a job. Assign until it reads zero and every dollar has a plan.",
  },
  {
    Icon: UsersThreeIcon,
    title: "One budget for the whole household",
    body: "Invite up to five people as editors or viewers. Changes appear live, and the history names who made each one.",
  },
  {
    Icon: TagIcon,
    title: "Targets for every bill and goal",
    body: "Weekly, monthly, yearly and dated targets show what is underfunded while there is still time to move money.",
  },
];

const states = [
  {
    key: "ready",
    Icon: CoinsIcon,
    title: "Ready to Assign",
    body: "Income waits here until you give it a job. Keep assigning until it reads $0.00.",
    wash: "from-tint-violet",
  },
  {
    key: "funded",
    Icon: CheckCircleIcon,
    title: "Funded",
    body: "The category holds what its target asks for, so spend from it without a second thought.",
    wash: "from-tint-green",
  },
  {
    key: "underfunded",
    Icon: ClockCountdownIcon,
    title: "Underfunded",
    body: "A target wants more before its date. You see it while there is still time to move money.",
    wash: "from-tint-yellow",
  },
  {
    key: "overspent",
    Icon: WarningCircleIcon,
    title: "Overspent",
    body: "Spending ran past what was there. Cover it from another category and the month adds up again.",
    wash: "from-tint-rose",
  },
] as const;

const steps = [
  {
    Icon: BankIcon,
    title: "Add your accounts",
    body: "Enter starting balances or import bank files in CSV, OFX, QFX or QIF. Duplicates are matched for you.",
  },
  {
    Icon: CoinsIcon,
    title: "Assign every dollar",
    body: "Move Ready to Assign into categories until it reads $0.00. Auto Assign fills your targets in one click.",
  },
  {
    Icon: ReceiptIcon,
    title: "Spend from what is there",
    body: "Each purchase comes out of its category. Leftovers roll into next month, and overspending shows up right away.",
  },
];

const quotes = [
  {
    quote:
      "We used to split costs in a spreadsheet and argue about it every Sunday. Now we see the same categories, and the history settles who moved what.",
    initials: "PR",
    color: "bg-[#4a6fd1]",
    name: "Priya Raman and Tomás Herrera",
    role: "Sharing one budget in Toronto",
  },
  {
    quote:
      "I'm paid in euros and send money home in pesos. It's the first budget that doesn't make me convert anything by hand.",
    initials: "LF",
    color: "bg-[#2e9478]",
    name: "Lucía Ferreyra",
    role: "Product designer in Lisbon",
  },
  {
    quote:
      "Moving over took one evening. I imported two years of bank files and Ready to Assign was at zero before dinner.",
    initials: "KO",
    color: "bg-[#d9922e]",
    name: "Kwame Osei",
    role: "Nurse in Leeds",
  },
];

/** The plan comparison under the pricing cards: true is included, a string is a qualified yes. */
const compare: { group: string; rows: [string, boolean | string, boolean | string][] }[] = [
  {
    group: "Budgeting",
    rows: [
      ["Zero based budget with targets and Auto Assign", true, true],
      ["Share with up to 5 people", true, true],
      ["150 currencies with daily rates", true, true],
      ["Bank file import with duplicate matching", true, true],
      ["8 reports with CSV export", true, true],
    ],
  },
  {
    group: "Running it",
    rows: [
      ["We handle updates and backups", true, false],
      ["Email summaries and password reset", true, "Optional"],
      ["Runs on your own server with Docker Compose", false, true],
      ["REST API and MCP server for AI agents", true, true],
    ],
  },
  {
    group: "Your data",
    rows: [
      ["Full JSON backup and CSV export", true, true],
      ["Open source under AGPL 3.0", true, true],
    ],
  },
];

const plans = [
  {
    name: "Hosted",
    tagline: "We run it, back it up and keep it current. You budget.",
    featured: true,
    cta: { label: "Start your budget", href: links.signUp },
    risk: "Cancel anytime and take a full backup with you.",
    features: [
      "Every feature, no tiers",
      "Share with up to 5 people",
      "150 currencies with daily rates",
      "Bank file import with duplicate matching",
      "8 reports with CSV export",
      "Email summaries and password reset",
    ],
  },
  {
    name: "Self hosted",
    tagline: "The same app as one Docker image on your own server.",
    featured: false,
    cta: { label: "Read the self hosting guide", href: links.selfHosting },
    risk: "Needs Docker with Compose and about 10 minutes.",
    features: [
      "Every hosted feature",
      "Runs next to PostgreSQL with Docker Compose",
      "Email is optional",
      "REST API and MCP server for AI agents",
      "You handle updates and backups",
    ],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: site.name,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Web",
    description: site.description,
    url: Astro.site?.href,
    offers: [
      {
        "@type": "Offer",
        price: String(price.monthly),
        priceCurrency: "USD",
        name: "Hosted, monthly",
      },
      {
        "@type": "Offer",
        price: String(price.yearly),
        priceCurrency: "USD",
        name: "Hosted, yearly",
      },
      { "@type": "Offer", price: "0", priceCurrency: "USD", name: "Self hosted" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base jsonLd={jsonLd}>
  <!-- Hero: the colour wash and grid run up under the navigation bar. -->
  <section class="relative isolate -mt-16 overflow-hidden px-6 pt-36 pb-16 lg:-mt-[4.5rem] lg:pt-48 lg:pb-20">
    <div aria-hidden="true" class="canvas-wash absolute inset-0 -z-10"></div>
    <div
      aria-hidden="true"
      class="absolute inset-x-0 top-0 -z-10 mx-auto h-[624px] max-w-[1320px] [mask-image:radial-gradient(ellipse_85%_100%_at_50%_10%,black_60%,transparent_100%)]"
    >
      <div class="canvas-grid absolute inset-0"></div>
      <div class="absolute inset-0 hidden grid-cols-7 grid-rows-[repeat(6,104px)] lg:grid">
        {
          tiles.map((tile, i) => (
            <div class={cn("p-2", tile.cell, tile.wide && "hidden xl:block")}>
              <div
                data-float
                style={`animation-delay: ${-i * 1.3}s`}
                class={cn(
                  "flex flex-col gap-0.5 rounded-md border-l-[3px] px-2.5 py-2 text-xs shadow-[0_1px_2px_rgb(0_0_0/0.04)]",
                  tile.tint,
                  tile.tall && "h-full",
                )}
              >
                <span class="truncate font-medium text-heading/85">{tile.name}</span>
                <span class="truncate text-heading/60 tabular-nums">{tile.detail}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mx-auto flex max-w-[680px] flex-col items-center gap-6 text-center">
      <h1
        class="text-gradient pb-1 text-[2.5rem] leading-[1.08] font-medium tracking-[-0.035em] sm:text-[3.5rem] lg:text-[4rem]"
      >
        Give every cent a job <br class="hidden sm:block" />before you spend it
      </h1>
      <p class="max-w-[34rem] text-lg text-muted-foreground sm:text-xl sm:leading-8">
        A zero based budget you can share with up to five people. Assign the money you actually have to
        the bills and goals ahead, in any of 150 currencies.
      </p>
      <div class="flex flex-col items-center gap-3 pt-2">
        <a href={links.signUp} class={cta}>
          Start your budget
          <ArrowRightIcon size={16} aria-hidden="true" />
        </a>
        <p class="text-sm text-muted-foreground">{site.riskNote}</p>
      </div>
    </div>

    <div
      class="mx-auto mt-20 flex max-w-[1120px] flex-col items-center gap-6 text-[0.9375rem] text-heading/80 lg:mt-28 lg:flex-row lg:justify-center lg:gap-8"
    >
      {
        [
          { label: "Runs on", items: runsOn },
          { label: "Works with", items: worksWith },
        ].map((group, g) => (
          <div class={cn("flex flex-col items-center gap-3 sm:flex-row sm:gap-6", g === 1 && "lg:border-l lg:pl-8")}>
            <span class="text-xs font-medium tracking-[0.08em] text-muted-foreground uppercase">{group.label}</span>
            <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2">
              {group.items.map(({ Icon, label }) => (
                <li class="flex items-center gap-2">
                  <span class="grid size-7 place-items-center rounded-full border bg-background text-heading/70 shadow-[0_1px_2px_rgb(0_0_0/0.04)]">
                    <Icon size={14} aria-hidden="true" />
                  </span>
                  {label}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Features: copy on the left, the budget on a painted backdrop running off the right edge. -->
  <section id="features" class="overflow-x-clip py-16 sm:py-24">
    <div class={cn(wrap, "grid items-center gap-12 lg:grid-cols-[400px_1fr] lg:gap-16")}>
      <div class="flex flex-col gap-10" data-reveal>
        <div class="flex flex-col gap-4">
          <span class="pill"><SquaresFourIcon size={14} aria-hidden="true" /> Everything in one place</span>
          <h2 class={h2}>Built for the way your money actually moves</h2>
        </div>
        <ul class="flex flex-col gap-8">
          {
            features.map(({ Icon, title, body }) => (
              <li class="flex gap-4">
                <Icon size={22} className="mt-0.5 shrink-0 text-heading/70" aria-hidden="true" />
                <div class="flex flex-col gap-2">
                  <div class="flex items-center gap-3">
                    <h3 class="text-lg font-medium text-heading">{title}</h3>
                    <span aria-hidden="true" class="hidden h-px flex-1 bg-gradient-to-r from-border to-transparent lg:block" />
                  </div>
                  <p class="text-base text-muted-foreground">{body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div
        class="wallpaper relative h-[360px] overflow-hidden rounded-2xl sm:h-[480px] lg:mr-[min(-1.5rem,calc((1120px-100vw)/2))] lg:h-[600px] lg:rounded-r-none"
        data-reveal
      >
        <div
          class="absolute top-8 left-6 w-[1100px] overflow-hidden rounded-tl-xl border border-white/40 bg-background shadow-[0_24px_64px_rgb(20_30_80/0.25)] sm:top-12 sm:left-12 lg:w-[1180px]"
        >
          <img
            src="/screenshots/budget-1440.webp"
            srcset="/screenshots/budget-960.webp 960w, /screenshots/budget-1440.webp 1440w, /screenshots/budget-2880.webp 2880w"
            sizes="(min-width: 1024px) 1180px, 1100px"
            width="2880"
            height="1800"
            alt="The budget screen: categories grouped into Bills, Needs and Wants with Assigned, Activity and Available, and All Money Assigned at the top right"
            fetchpriority="high"
            class="block h-auto w-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Money states: four tinted cards, one per colour the budget uses. -->
  <section class={cn(wrap, "flex flex-col gap-12 py-16 sm:py-24")}>
    <div class="mx-auto flex max-w-[640px] flex-col items-center gap-4 text-center" data-reveal>
      <span class="pill"><EyeIcon size={14} aria-hidden="true" /> See where you stand</span>
      <h2 class={h2}>Every category says where it stands</h2>
      <p class={lead}>
        Colour means the same thing everywhere in the app, so one look at the budget tells you what is covered
        and what needs you.
      </p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {
        states.map(({ key, Icon, title, body, wash }) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border bg-background shadow-[0_1px_2px_rgb(0_0_0/0.03)]">
            <div class={cn("flex h-40 items-center bg-gradient-to-b to-background px-4", wash)}>
              <div class="w-full rounded-lg border bg-background p-3 shadow-[0_4px_12px_rgb(0_0_0/0.06)]">
                {key === "ready" && (
                  <div class="flex items-center justify-between gap-2 rounded-md bg-green-200 px-3 py-2 text-green-950">
                    <span class="grid">
                      <span class="text-lg font-semibold tabular-nums">$4,812.37</span>
                      <span class="text-xs">Ready to Assign</span>
                    </span>
                    <span class={buttonClass("default", "small", "pointer-events-none h-7 px-2 text-xs")}>Assign</span>
                  </div>
                )}
                {key === "funded" && (
                  <div class="flex flex-col gap-2">
                    <div class="flex items-center justify-between gap-2 text-sm">
                      <span class="truncate">🚗 Car insurance</span>
                      <AvailablePill amount="$142.38" tone="positive" mark="met" />
                    </div>
                    <ProgressBar percent={100} tone="funded" />
                    <p class="text-xs text-muted-foreground"><span class="font-medium text-foreground">Funded</span></p>
                  </div>
                )}
                {key === "underfunded" && (
                  <div class="flex flex-col gap-2">
                    <div class="flex items-center justify-between gap-2 text-sm">
                      <span class="truncate">✈️ Flights</span>
                      <AvailablePill amount="$380.00" tone="caution" mark="pie" funded={32} />
                    </div>
                    <ProgressBar percent={32} tone="underfunded" />
                    <p class="text-xs text-muted-foreground">
                      <span class="font-medium text-foreground">$820.00 more</span> by May 1
                    </p>
                  </div>
                )}
                {key === "overspent" && (
                  <div class="flex flex-col gap-2">
                    <div class="flex items-center justify-between gap-2 text-sm">
                      <span class="truncate">🍽️ Dining out</span>
                      <AvailablePill amount="−$12.40" tone="negative" />
                    </div>
                    <div class="h-1 rounded-full bg-red-500"></div>
                    <p class="text-xs text-muted-foreground">
                      <span class="font-medium text-foreground">Spent $162.40</span> of $150.00
                    </p>
                  </div>
                )}
              </div>
            </div>
            <div class="flex flex-col gap-2 p-5 pt-3">
              <h3 class="flex items-center gap-2 text-base font-medium text-heading">
                <Icon size={18} className="text-heading/70" aria-hidden="true" />
                {title}
              </h3>
              <p class="text-[0.9375rem] text-muted-foreground">{body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- How it works: the budget before and after assigning, on the backdrop, then the three steps. -->
  <section id="how-it-works" class={cn(wrap, "flex flex-col gap-12 py-16 sm:py-24")}>
    <div class="mx-auto flex max-w-[640px] flex-col items-center gap-4 text-center" data-reveal>
      <span class="pill"><PathIcon size={14} aria-hidden="true" /> How it works</span>
      <h2 class={h2}>Three steps, then a monthly habit</h2>
      <p class={lead}>Set it up in an evening. After that it is a few minutes whenever money comes in.</p>
    </div>
    <div class="wallpaper overflow-hidden rounded-2xl px-4 pt-8 sm:px-10 sm:pt-12" data-reveal>
      <div
        class="mx-auto grid max-w-[880px] items-start gap-4 [mask-image:linear-gradient(to_bottom,black_70%,transparent)] md:grid-cols-[1fr_auto_1fr] md:gap-6"
      >
        <div class="flex flex-col gap-3 pb-10">
          <span class="w-fit rounded-full bg-white/70 px-2.5 py-1 text-xs font-medium text-heading backdrop-blur">
            Payday
          </span>
          <BudgetMini state="start" class="shadow-[0_24px_48px_rgb(20_30_80/0.2)]" />
        </div>
        <span
          aria-hidden="true"
          class="hidden size-10 place-items-center self-center rounded-full bg-white/80 text-heading shadow-sm backdrop-blur md:grid"
        >
          <ArrowRightIcon size={18} />
        </span>
        <div class="flex flex-col gap-3 pb-10">
          <span class="w-fit rounded-full bg-white/70 px-2.5 py-1 text-xs font-medium text-heading backdrop-blur">
            Ten minutes later
          </span>
          <BudgetMini state="assigned" class="shadow-[0_24px_48px_rgb(20_30_80/0.2)]" />
        </div>
      </div>
    </div>
    <ol class="grid gap-10 md:grid-cols-3 md:gap-8" data-reveal>
      {
        steps.map(({ Icon, title, body }, i) => (
          <li class="flex gap-4">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg border bg-background text-heading/70 shadow-[0_1px_2px_rgb(0_0_0/0.04)]">
              <Icon size={18} aria-hidden="true" />
            </span>
            <div class="flex flex-col gap-1.5">
              <h3 class="text-lg font-medium text-heading">
                <span class="text-muted-foreground tabular-nums">{i + 1}.</span> {title}
              </h3>
              <p class="text-base text-muted-foreground">{body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Why it works: a two-tone heading over three tinted cards. -->
  <section class={cn(wrap, "flex flex-col gap-12 py-16 sm:py-24")}>
    <div class="mx-auto flex max-w-[760px] flex-col items-center gap-4 text-center" data-reveal>
      <span class="pill"><LightbulbIcon size={14} aria-hidden="true" /> Why it works</span>
      <h2 class={h2}>
        Most money apps tell you where it went. <span class="text-muted-foreground">This one asks where it should go.</span>
      </h2>
      <p class={lead}>
        Tracking shows you last month's damage. A zero based budget plans the next one, so in March the car
        insurance already has its $142.38 and groceries run out of room instead.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-3" data-reveal>
      {
        [
          {
            Icon: UsersThreeIcon,
            title: "Budget together",
            body: "Owners, editors and viewers share one budget, and every change is named in its history.",
            tint: "from-tint-peach via-tint-peach/60 border-[oklch(88%_0.05_55)]",
            vignette: "sharing",
          },
          {
            Icon: ChartBarIcon,
            title: "Reports that answer one question",
            body: "Spending, net worth, age of money and credit card health, each with a CSV export.",
            tint: "from-tint-violet via-tint-violet/60 border-[oklch(88%_0.05_300)]",
            vignette: "report",
          },
          {
            Icon: SealCheckIcon,
            title: "Your data stays yours",
            body: "Download a full backup or a CSV whenever you like, and restore it on your own server.",
            tint: "from-tint-cobalt via-tint-cobalt/60 border-[oklch(88%_0.04_265)]",
            vignette: "export",
          },
        ].map(({ Icon, title, body, tint, vignette }) => (
          <article class={cn("flex flex-col overflow-hidden rounded-2xl border bg-gradient-to-b to-background", tint)}>
            <div class="flex h-64 items-end justify-center px-5 pt-6">
              {vignette === "sharing" && (
                <div class="w-full self-center">
                  <Sharing />
                </div>
              )}
              {vignette === "export" && (
                <div class="w-full self-center">
                  <DataExport />
                </div>
              )}
              {vignette === "report" && (
                <div class="h-full w-full overflow-hidden rounded-t-lg border border-b-0 bg-background shadow-[0_8px_24px_rgb(0_0_0/0.06)]">
                  {/* Zoomed to the top left: the totals and the first card's verdict. */}
                  <img
