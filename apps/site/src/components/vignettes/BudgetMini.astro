---
import { CheckCircleIcon } from "@phosphor-icons/react/ssr";
import { buttonClass, cn } from "../../lib/ui";
import AvailablePill from "./AvailablePill.astro";

// The budget's Ready to Assign banner (apps/web/src/components/ready-to-assign.tsx) over a few
// categories. "assigned": every dollar has a job. "start": money waiting, categories at zero.
interface Props {
  state: "assigned" | "start";
  class?: string;
}
const { state, class: className } = Astro.props;
const categories = [
  ["🏠 Rent", "$1,450.00"],
  ["🛒 Groceries", "$612.40"],
  ["⚡ Utilities", "$102.00"],
  ["🛟 Emergency fund", "$250.00"],
] as const;
---

<div
  class={cn(
    "flex w-full flex-col gap-3 rounded-lg border bg-background p-3 shadow-[0_1px_2px_rgb(0_0_0/0.04)]",
    className,
  )}
>
  {
    state === "assigned" ? (
      <div class="flex items-center justify-between gap-3 rounded-lg bg-muted px-4 py-2 text-muted-foreground">
        <span class="grid">
          <span class="text-2xl font-semibold tabular-nums">$0.00</span>
          <span class="text-sm">All Money Assigned</span>
        </span>
        <CheckCircleIcon size={24} aria-hidden="true" />
      </div>
    ) : (
      <div class="flex items-center justify-between gap-3 rounded-lg bg-green-200 px-4 py-2 text-green-950">
        <span class="grid">
          <span class="text-2xl font-semibold tabular-nums">$4,812.37</span>
          <span class="text-sm">Ready to Assign</span>
        </span>
        <span class={buttonClass("default", "small", "pointer-events-none")}>Assign</span>
      </div>
    )
  }
  <table class="w-full overflow-hidden rounded-lg text-left text-sm ring-1 ring-border">
    <thead class="bg-muted/50 text-xs text-muted-foreground">
      <tr>
        <th scope="col" class="h-8 px-3 font-medium">Category</th>
        <th scope="col" class="h-8 px-3 text-right font-medium">Available</th>
      </tr>
    </thead>
    <tbody>
      {
        categories.map(([name, amount]) => (
          <tr class="border-t">
            <td class="h-10 px-3">{name}</td>
            <td class="h-10 px-3 text-right">
              <AvailablePill
                amount={state === "assigned" ? amount : "$0.00"}
                tone={state === "assigned" ? "positive" : "zero"}
              />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
