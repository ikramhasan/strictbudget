---
import { CheckCircleIcon } from "@phosphor-icons/react/ssr";
import AvailablePill from "../vignettes/AvailablePill.astro";

// A month's plan by category group, with Ready to Assign at zero above it.
interface Props {
  groups: [name: string, amount: string][];
}
const { groups } = Astro.props;
---

<div
  class="flex w-full max-w-120 flex-col gap-3 rounded-lg border bg-background p-3 text-sm shadow-[0_8px_24px_rgb(26_26_26/0.06)]"
>
  <div class="flex items-center justify-between gap-3 rounded-lg bg-muted px-4 py-2 text-muted-foreground">
    <span class="grid">
      <span class="text-2xl font-semibold tabular-nums">$0.00</span>
      <span class="text-sm">All Money Assigned</span>
    </span>
    <CheckCircleIcon size={24} aria-hidden="true" />
  </div>
  <table class="w-full overflow-hidden rounded-lg text-left ring-1 ring-border">
    <thead class="bg-muted/50 text-xs text-muted-foreground">
      <tr>
        <th scope="col" class="h-8 px-3 font-medium">Category group</th>
        <th scope="col" class="hidden h-8 px-3 text-right font-medium sm:table-cell">Assigned</th>
        <th scope="col" class="h-8 px-3 text-right font-medium">Available</th>
      </tr>
    </thead>
    <tbody class="tabular-nums">
      {
        groups.map(([name, amount]) => (
          <tr class="border-t">
            <td class="h-10 px-3 font-medium">{name}</td>
            <td class="hidden h-10 px-3 text-right sm:table-cell">{amount}</td>
            <td class="h-10 px-3 text-right">
              <AvailablePill amount={amount} tone="positive" />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
