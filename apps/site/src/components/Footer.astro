---
import { GithubLogoIcon } from "@phosphor-icons/react/ssr";
import { links } from "../lib/site";

const columns = [
  {
    heading: "Product",
    items: [
      { label: "Features", href: "/#features" },
      { label: "How it works", href: "/#how-it-works" },
      { label: "Pricing", href: "/#pricing" },
      { label: "FAQ", href: "/#faq" },
      { label: "Blog", href: "/blog" },
      { label: "Sign in", href: links.signIn },
    ],
  },
  {
    heading: "Open source",
    items: [
      { label: "GitHub", href: links.github },
      { label: "Self hosting guide", href: links.selfHosting },
      { label: "API reference", href: links.apiReference },
      { label: "Changelog", href: links.changelog },
    ],
  },
  {
    heading: "Legal",
    items: [
      { label: "Privacy policy", href: "/privacy" },
      { label: "Terms of service", href: "/terms" },
    ],
  },
];
const linkClass =
  "rounded-sm text-[0.9375rem] text-heading/80 transition-colors duration-300 ease-site outline-none hover:text-primary-ink focus-visible:ring-2 focus-visible:ring-ring";
---

<footer class="px-6 pt-16 pb-10 sm:pt-20">
  <div class="mx-auto flex max-w-[1120px] flex-col gap-12">
    <div class="flex flex-col justify-between gap-12 lg:flex-row">
      <div class="flex flex-col gap-4">
        <a href="/" class="w-fit rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-ring">
          <img src="/logo.svg" alt="strictbudget home" width="117" height="24" class="h-6 w-auto" />
        </a>
        <p class="max-w-64 text-[0.9375rem] text-muted-foreground">
          Zero based budgeting you can share, in every currency you use. Open source, and yours to keep.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:gap-16">
        {
          columns.map((column) => (
            <div class="flex flex-col gap-4 lg:w-36">
              <h2 class="text-xs font-medium tracking-[0.08em] text-muted-foreground uppercase">{column.heading}</h2>
              <ul class="flex flex-col gap-3">
                {column.items.map((item) => (
                  <li>
                    <a href={item.href} class={linkClass}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div class="flex items-center justify-between gap-4 border-t pt-8">
      <p class="text-[0.8125rem] text-muted-foreground">© 2026 strictbudget. Open source under AGPL 3.0.</p>
      <a
        href={links.github}
        aria-label="strictbudget on GitHub"
        class="grid size-9 place-items-center rounded-full text-muted-foreground transition-colors duration-300 ease-site outline-none hover:bg-accent hover:text-heading focus-visible:ring-2 focus-visible:ring-ring"
      >
        <GithubLogoIcon size={20} />
      </a>
    </div>
  </div>
</footer>
