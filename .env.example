# Postgres (docker compose)
DATABASE_URL=postgres://strictbudget:strictbudget@localhost:5432/strictbudget
TEST_DATABASE_URL=postgres://strictbudget:strictbudget@localhost:5432/strictbudget_test

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public URL the browser uses to reach /api/auth (the Vite dev server proxies it)
BETTER_AUTH_URL=http://localhost:5173
# Origin of the web app (CORS + Better Auth trusted origin)
WEB_ORIGIN=http://localhost:5173

PORT=3000

# self-hosted (default) or cloud (the hosted strictbudget; requires email in production)
STRICTBUDGET_DEPLOYMENT=

# Email (Resend). Without a key, development prints emails (and their links) to the API console,
# and a self-hosted production server sends none: addresses aren't confirmed, there's no password
# reset link, and invitations are shared as links. Required for cloud. FROM_EMAIL is an address,
# "Name <address>", or a verified sending domain (sent as no-reply@ that domain).
RESEND_API_KEY=
FROM_EMAIL=
# Optional: comma-separated CIDRs of reverse proxies in front of the API, so rate limits trust
# x-forwarded-for only through them.
TRUSTED_PROXIES=
# Optional: instead, a header your host's edge sets to the client IP and overwrites on every
# request (Railway: x-real-ip).
CLIENT_IP_HEADER=

# Transaction attachments: an S3-compatible bucket (Railway Buckets: its BUCKET, ENDPOINT,
# REGION, ACCESS_KEY_ID and SECRET_ACCESS_KEY). Without one, development keeps files on disk in
# STORAGE_DIR (default .storage); production with neither turns attachments off.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style bucket URLs (older Railway buckets, MinIO): true or false
S3_FORCE_PATH_STYLE=
STORAGE_DIR=

# In-app AI assistant: an Anthropic API key. Without one, in-app AI is off and budget settings
# explain why. AI_MODEL picks the Claude model (default claude-sonnet-5-5).
AI_API_KEY=
AI_MODEL=
# Optional: a TinyFish API key (agent.tinyfish.ai/api-keys) lets the assistant search the web and
# read pages, such as to find out what an unfamiliar payee is before picking its category.
TINYFISH_API_KEY=
