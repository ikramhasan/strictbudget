{
  "name": "strictbudget",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:up && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "generate": "turbo run generate",
    "check": "biome check . && tsc -p .railway && turbo run typecheck test build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @strictbudget/db db:generate",
    "db:migrate": "pnpm --filter @strictbudget/api db:migrate",
    "db:studio": "pnpm --filter @strictbudget/db db:studio",
    "db:seed": "pnpm --filter @strictbudget/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "railway": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
