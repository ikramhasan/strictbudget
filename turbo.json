{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "openapi:emit": {
      "inputs": ["src/**", "package.json"],
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": ["src/*.gen.ts"]
    },
    "@strictbudget/api-client#generate": {
      "dependsOn": ["@strictbudget/api#openapi:emit"],
      "inputs": ["../../apps/api/openapi.json", "package.json"],
      "outputs": ["src/schema.gen.ts"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^generate", "generate"],
      "cache": false,
      "passThroughEnv": ["API_TEST_WORKERS"]
    },
    "build": {
      "dependsOn": ["^generate", "generate"],
      "outputs": ["dist/**"]
    }
  }
}
